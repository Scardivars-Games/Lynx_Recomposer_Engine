{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Release -- Unoptimized",
            "displayName": "Release -- Unoptimized",
            "description": "Configura el proyecto en modo Release pero sin optimizaciones, para usar ILEN_ENGINE como libreria de cosas que no sean juegos",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/release-unoptimized",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Release -- Optimized",
            "displayName": "Release -- Optimized",
            "description": "Configura el proyecto en modo Release con optimizaciones, para usar ILEN_ENGINE como libreria de cosas que no sean juegos",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/release-opt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LYNX_OPTIMIZED_BUILD_FLAGS": "ON"
            }
        },
        {
            "name": "Release -- Optimized + MetalHUD",
            "displayName": "Release -- Optimized + MetalHUD",
            "description": "Configura el proyecto en modo Release con optimizaciones, para usar ILEN_ENGINE como libreria de cosas que no sean juegos",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/release-opt-metalhud",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LYNX_OPTIMIZED_BUILD_FLAGS": "ON",
                "LYNX_METAL_HUD": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-metalhud",
            "displayName": "Debug + MetalHUD",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/debug-metalhud",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LYNX_METAL_HUD": "ON"
            }
        },
        {
            "name": "sdk-release-macOS",
            "displayName": "Release -- Only Dynamic Lib for macOS",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/sdk-release",
            "installDir": "${sourceDir}/dist/LynxSDK-macOS-release",
            "toolchainFile": "${sourceDir}/toolchains/macos.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LYNX_OPTIMIZED_BUILD_FLAGS": "ON",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "LRE_BUILD_GAME_PROJECT": "OFF",
                "LRE_BUILD_ENGINE_ASSETS": "ON",
                "LRE_TOOLS_USE_BUNDLED_ASSIMP": "ON"
            }   
        }
    ],
    "buildPresets": [
        {
            "name": "Release -- Optimized Build",
            "configurePreset": "Release -- Optimized",
            "jobs": 7
        },
        {
            "name": "Debug",
            "description": "",
            "configurePreset": "debug",
            "displayName": "",
            "inherits": [
                "Release -- Optimized Build"
            ]
        },
        {   
            "name": "Debug -- Metal",
            "description": "",
            "configurePreset": "debug-metalhud",
            "displayName": "",
            "inherits": [
                "Release -- Optimized Build"
            ]
        },
        {
            "name" : "sdk-release-macos-build",
            "displayName": "Build LynxSDK",
            "configurePreset": "sdk-release-macOS",
            "targets": [
                "lre_workspace"
            ],
            "jobs": 7
        },
        {
            "name": "sdk-release-macos-install",
            "displayName": "Install LynxSDK",
            "configurePreset": "sdk-release-macOS",
            "targets": [
                "install"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "install-sdk-macOS",
            "displayName": "Release -- Only Dynamic Lib for macOS",
            "steps": [
                {
                    "type": "configure",
                    "name": "sdk-release-macOS"
                },
                {
                    "type": "build",
                    "name": "sdk-macos-build"
                },
                {
                    "type": "build",
                    "name": "sdk-macos-install"
                }
            ]
        }
    ]
}