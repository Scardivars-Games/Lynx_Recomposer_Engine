set(CMAKE_SYSTEM_NAME iOS)
if(NOT DEFINED PLATFORM)
    set(PLATFORM OS64)
endif()

set(LRE_IOS_DEPLOYMENT_TARGET "15.0" CACHE STRING "Minimum supported iOS version")

find_program(XCRUN_EXECUTABLE xcrun)
if(NOT XCRUN_EXECUTABLE)
    message(FATAL_ERROR "xcrun no encontrado")
endif()

if(PLATFORM STREQUAL "OS64")
    set(IOS_SDK_NAME "iphoneos")
    set(CMAKE_SYSTEM_PROCESSOR arm64)
    set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "iOS device architectures" FORCE)
elseif(PLATFORM STREQUAL "SIMULATOR")
    set(IOS_SDK_NAME "iphonesimulator")
    set(CMAKE_SYSTEM_PROCESSOR arm64)
    set(LRE_IOS_SIMULATOR_ARCHITECTURES "arm64;x86_64" CACHE STRING "iOS simulator architectures")
    set(CMAKE_OSX_ARCHITECTURES "${LRE_IOS_SIMULATOR_ARCHITECTURES}" CACHE STRING "iOS simulator architectures" FORCE)
else()
    message(FATAL_ERROR "PLATFORM must be OS64 or SIMULATOR")
endif()

execute_process(
    COMMAND ${XCRUN_EXECUTABLE} --sdk ${IOS_SDK_NAME} --show-sdk-path
    OUTPUT_VARIABLE IOS_SDK_PATH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
    COMMAND ${XCRUN_EXECUTABLE} --sdk ${IOS_SDK_NAME} --find clang
    OUTPUT_VARIABLE IOS_CLANG
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
    COMMAND ${XCRUN_EXECUTABLE} --sdk ${IOS_SDK_NAME} --find clang++
    OUTPUT_VARIABLE IOS_CLANGXX
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY
)

set(CMAKE_OSX_SYSROOT "${IOS_SDK_PATH}" CACHE PATH "iOS SDK" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "${LRE_IOS_DEPLOYMENT_TARGET}" CACHE STRING "Minimum supported iOS version" FORCE)
set(CMAKE_C_COMPILER "${IOS_CLANG}" CACHE FILEPATH "Apple Clang C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${IOS_CLANGXX}" CACHE FILEPATH "Apple Clang C++ compiler" FORCE)

set(CMAKE_XCODE_ATTRIBUTE_CLANG_ENABLE_OBJC_ARC "YES")
set(CMAKE_XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2")
